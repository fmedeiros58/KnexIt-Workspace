<svg xmlns="http://www.w3.org/2000/svg" width="800" height="520" viewBox="0 0 800 520">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F5F8FF"/>
      <stop offset="1" stop-color="#E7F0FF"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="10" stdDeviation="12" flood-opacity="0.18"/>
    </filter>
  </defs>
  <rect width="800" height="520" rx="32" fill="url(#bg)"/>
  <rect x="80" y="90" width="420" height="260" rx="18" fill="#FFFFFF" stroke="#DCE7F7"/>
  <rect x="120" y="130" width="220" height="16" rx="8" fill="#D5E3F7"/>
  <rect x="120" y="160" width="260" height="14" rx="7" fill="#E4ECFA"/>
  <rect x="120" y="186" width="200" height="14" rx="7" fill="#E4ECFA"/>
  <rect x="120" y="212" width="220" height="14" rx="7" fill="#E4ECFA"/>
  <g filter="url(#shadow)">
    <rect x="360" y="120" width="320" height="220" rx="20" fill="#FFFFFF" stroke="#DCE7F7"/>
    <rect x="392" y="150" width="160" height="14" rx="7" fill="#E4ECFA"/>
    <rect x="392" y="176" width="220" height="14" rx="7" fill="#E4ECFA"/>
    <rect x="392" y="202" width="200" height="14" rx="7" fill="#E4ECFA"/>
    <rect x="392" y="228" width="230" height="14" rx="7" fill="#E4ECFA"/>
    <rect x="392" y="266" width="120" height="30" rx="15" fill="#2F7BFF"/>
  </g>
</svg>
