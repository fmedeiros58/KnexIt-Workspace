{
  "name": "knexit-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-smart.mjs",
    "dev:next": "next dev -H 0.0.0.0 -p 3000",
    "dev:restart": "powershell -ExecutionPolicy Bypass -File scripts/dev-restart.ps1",
    "dev:app": "npm run dev:next",
    "dev:knexchat": "node scripts/dev-knexchat.cjs",
    "dev:knexai": "start \"\" http://localhost:3004/knexai && next dev -H 127.0.0.1 -p 3004",
    "dev:supadrive": "start \"\" http://localhost:3005/supadrive && next dev -H 127.0.0.1 -p 3005",
    "dev:vioclass": "start \"\" http://localhost:3006/vioclass && next dev -H 127.0.0.1 -p 3006",
    "dev:vioread": "start \"\" http://localhost:3007/vioread && next dev -H 127.0.0.1 -p 3007",
    "build": "next build",
    "test": "jest --runInBand",
    "db:types:gen": "node scripts/gen-supabase-types.mjs",
    "db:types:check": "node scripts/check-supabase-types.mjs",
    "db:types:doctor": "node scripts/doctor-supabase-types.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "serve:next:wsl": "powershell -ExecutionPolicy Bypass -File scripts/serve-next-wsl.ps1",
    "serve:embeddings:cpu": "powershell -ExecutionPolicy Bypass -File scripts/serve-embeddings-cpu-wsl.ps1",
    "serve:embeddings:cpu:restart": "powershell -ExecutionPolicy Bypass -File scripts/serve-embeddings-cpu-restart.ps1",
    "serve:vllm:wsl": "powershell -ExecutionPolicy Bypass -File scripts/serve-vllm-wsl.ps1",
    "serve:vllm:wsl:restart": "powershell -ExecutionPolicy Bypass -File scripts/serve-vllm-restart.ps1",
    "serve:knexai:watchdog": "powershell -ExecutionPolicy Bypass -File scripts/watch-knexai-backends.ps1",
    "serve:knexai:watchdog:install": "powershell -ExecutionPolicy Bypass -File scripts/install-backends-watchdog-task.ps1 -StartNow",
    "serve:knexai:watchdog:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-backends-watchdog-task.ps1 -StopRunning",
    "serve:knexai:watchdog:status": "powershell -ExecutionPolicy Bypass -File scripts/status-backends-watchdog-task.ps1",
    "serve:backends:watchdog:install": "powershell -ExecutionPolicy Bypass -File scripts/install-backends-watchdog-task.ps1 -StartNow",
    "serve:backends:watchdog:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-backends-watchdog-task.ps1 -StopRunning",
    "serve:backends:watchdog:status": "powershell -ExecutionPolicy Bypass -File scripts/status-backends-watchdog-task.ps1",
    "serve:docker:watchdog": "powershell -ExecutionPolicy Bypass -File scripts/watch-knexai-backends.ps1 -DisableVllmWatch -DisableEmbeddingsWatch -DisableKubernetesWatch",
    "serve:docker:watchdog:install": "powershell -ExecutionPolicy Bypass -File scripts/install-docker-watchdog-task.ps1 -StartNow",
    "serve:docker:watchdog:uninstall": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-docker-watchdog-task.ps1 -StopRunning",
    "serve:docker:watchdog:status": "powershell -ExecutionPolicy Bypass -File scripts/status-docker-watchdog-task.ps1",
    "serve:vllm": "vllm serve models/CModelosMistral-7B-Instruct-v0.2-AWQ --host 127.0.0.1 --port 8000 --served-model-name mistral-awq --max-num-seqs 2 --max-model-len 4096 --gpu-memory-utilization 0.90",
    "email:test": "node scripts/email-test.mjs",
    "supabase:local:start": "powershell -ExecutionPolicy Bypass -File scripts/supabase-local-start.ps1 -SkipEnvUpdate",
    "supabase:local:start:update-env": "powershell -ExecutionPolicy Bypass -File scripts/supabase-local-start.ps1",
    "supabase:local:prep-nvme": "powershell -ExecutionPolicy Bypass -File scripts/configure-docker-nvme2.ps1",
    "supabase:local:apply-engine-template": "powershell -ExecutionPolicy Bypass -File scripts/apply-docker-engine-template.ps1",
    "supabase:local:identity:migrate": "powershell -ExecutionPolicy Bypass -File scripts/supabase-apply-identity-migrations.ps1",
    "supabase:local:identity:migrate:sh": "bash scripts/supabase-apply-identity-migrations.sh",
    "verify:nvme": "powershell -ExecutionPolicy Bypass -File scripts/verify-nvme-setup.ps1",
    "verify:nvme:sh": "bash scripts/verify-nvme-setup.sh",
    "health:chat-pipeline": "node scripts/check-chat-pipeline.mjs",
    "smoke:api": "bash scripts/smoke-test-api.sh",
    "smoke:rag": "bash scripts/smoke-test-rag.sh",
    "smoke:rag:v2": "bash scripts/smoke_rag_v2",
    "rag:reindex:gaps": "node scripts/rag-reindex-gapped-docs.mjs --auto-gaps",
    "bench:rag:router": "node scripts/bench-rag-router.mjs",
    "bench:rag:router:wsl": "powershell -ExecutionPolicy Bypass -File scripts/bench-rag-router-wsl.ps1",
    "verify:public-api": "powershell -ExecutionPolicy Bypass -File scripts/check-public-api.ps1"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.15",
    "@livekit/components-styles": "^1.1.6",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@napi-rs/canvas": "^0.1.95",
    "@supabase/supabase-js": "^2.45.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-character-count": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-font-family": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@upstash/redis": "^1.36.1",
    "cors": "^2.8.5",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^4.17.3",
    "epubjs": "^0.3.93",
    "fastify": "^5.6.2",
    "franc-min": "^6.2.0",
    "livekit-client": "^2.15.8",
    "livekit-server-sdk": "^2.14.0",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.11.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.48.0",
    "next": "14.2.33",
    "openai": "^6.25.0",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.19.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "resend": "^6.5.2",
    "siriwave": "^2.4.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.13",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "20.14.12",
    "@types/pg": "^8.18.0",
    "@types/react": "18.3.5",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.3",
    "jest": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.10",
    "ts-jest": "^29.4.6",
    "typescript": "5.4.5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "next": "14.2.33"
  }
}
