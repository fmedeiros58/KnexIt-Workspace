# Supabase (exemplo)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_AQUI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco vetorial (Postgres + pgvector)
# Se VECTOR_DATABASE_URL estiver vazio, o sistema usa DATABASE_URL (quando existir)
# ou monta uma URL com VECTOR_DB_*.
DATABASE_URL=
VECTOR_DATABASE_URL=
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=postgres
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_SSL=0
EMBEDDING_DIMENSION=768
VECTOR_DISTANCE_STRATEGY=cosine
VECTOR_SEARCH_TOP_K_DEFAULT=8
VECTOR_SEARCH_TOP_K_MAX=50
# opcional: corte por distancia (cosine) no retrieval
# VECTOR_SEARCH_MAX_DISTANCE_DEFAULT=0.45
VECTOR_MIGRATION_FILE=supabase/migrations/20260303120000_create_rag_base_schema.sql
VECTOR_HNSW_MIGRATION_FILE=supabase/migrations/20260303130000_add_hnsw_index_chunk_embeddings.sql
RAG_MAX_FILE_SIZE_BYTES=20971520
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=180
RAG_MAX_CHUNKS_PER_DOC=5000
RAG_INGEST_EMBED_CHUNKS=1
RAG_INGEST_EMBED_REQUIRED=0
RAG_INGEST_EMBED_BATCH_SIZE=16
# token opcional para habilitar ingestao em massa de super admin (POST /api/ingest com sourcePaths[])
RAG_INGEST_ADMIN_TOKEN=
# Embedding da pergunta (RAG)
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_API_KEY=token-local
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_BASE_URL_FALLBACKS=http://localhost:8001/v1
EMBEDDING_HEALTHCHECK_PATH=/health
EMBEDDING_HEALTHCHECK_CACHE_MS=15000
# Fallback automatico Windows -> WSL (usa `wsl hostname -I` quando endpoint loopback falha)
EMBEDDING_WSL_DISCOVERY_ENABLED=1
# Opcional: fixa o IP WSL manualmente para fallback, sem autodiscovery
# EMBEDDING_WSL_HOST_IP=
# strict = retorna erro; degrade = responde sem retrieval vetorial quando embeddings cair
RAG_EMBEDDING_FAILURE_MODE=degrade
# Servidor local de embeddings em CPU (scripts/serve-embeddings-cpu.sh)
EMBEDDING_CPU_MODEL=intfloat/multilingual-e5-base
EMBEDDING_CPU_DEVICE=cpu
EMBEDDING_CPU_HOST=0.0.0.0
EMBEDDING_CPU_PORT=8001
EMBEDDING_CPU_API_KEY=token-local
# Retrieval/context pack
RAG_CONTEXT_MAX_CHARS=18000
RAG_CONTEXT_MAX_CHUNKS=20
RAG_LATENCY_PRESET=default
RAG_STREAM_CONTEXT_MAX_CHARS=18000
RAG_STREAM_HISTORY_MAX_MESSAGES=8
RAG_STREAM_HISTORY_MAX_CHARS=8000
RAG_STREAM_MAX_TOKENS=8192
RAG_STREAM_SKIP_FULLDOC=0
RAG_LATENCY_GUARD_MIN_CHUNKS=3
RAG_STREAM_SHOW_PASSES=1
RAG_STREAM_V2_CHUNK_SIZE=240
# Leitura integral de documentos (auditoria/acuracia)
RAG_FULL_DOCUMENT_READ_ENABLED=1
RAG_FULL_DOCUMENT_MAX_DOCS=2
RAG_FULL_DOCUMENT_MAX_CONTEXT_CHARS=24000
# Geracao de resposta (RAG)
RAG_RESPONSE_MAX_TOKENS=12288
RAG_RESPONSE_TEMPERATURE=0
RAG_RESPONSE_SEED=42
RAG_CHAT_HISTORY_MAX_MESSAGES=16
RAG_CHAT_HISTORY_MAX_CHARS=20000
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
RAG_LLM_HOST_ONLY=1
RAG_LLM_BASE_URL_FALLBACKS=
RAG_LLM_API_KEY=token-local
RAG_LLM_MODEL_NAME=mistral-awq
RAG_DEFAULT_RESPONSE_LANGUAGE_ID=pt-BR
RAG_DEFAULT_RESPONSE_LANGUAGE=portugues brasileiro
RAG_LLM_TIMEOUT_MS=45000
RAG_LLM_CONTEXT_WINDOW=8192
RAG_LLM_TIMEOUT_MAX_MS=180000
RAG_LLM_FIRST_TOKEN_TIMEOUT_MS=90000
RAG_LLM_HEALTHCHECK_PATH=/v1/models
RAG_LLM_HEALTHCHECK_CACHE_MS=10000
RAG_LLM_RETRY_ATTEMPTS=2
RAG_LLM_RETRY_BACKOFF_MS=250
RAG_LLM_TIMEOUT_LITE_MS=12000
RAG_LLM_TIMEOUT_FULL_MS=45000
RAG_LLM_RETRY_ATTEMPTS_LITE=1
RAG_LLM_RETRY_ATTEMPTS_FULL=2
RAG_LLM_KEEPALIVE_ENABLED=1
RAG_LLM_KEEPALIVE_CONNECTIONS=16
RAG_LLM_KEEPALIVE_TIMEOUT_MS=30000
RAG_LLM_KEEPALIVE_MAX_TIMEOUT_MS=120000
RAG_LLM_CIRCUIT_BREAKER_ENABLED=1
RAG_LLM_CIRCUIT_BREAKER_THRESHOLD=3
RAG_LLM_CIRCUIT_BREAKER_OPEN_MS=15000
RAG_LLM_MIN_BUDGET_PER_CALL=384
RAG_LLM_STREAM_MIN_BUDGET_PER_CALL=384
# Trava de teto de tokens por chamada no cliente LLM (aplicada em stream e non-stream)
RAG_LOCKED_MAX_TOKENS_PER_CALL=16384
RAG_LLM_MAXIMIZE_OUTPUT_TOKENS=1
RAG_LLM_MAXIMIZE_OUTPUT_RATIO_PERCENT=70
# 0 = prioriza contexto e permite conhecimento geral em perguntas genericas quando contexto vier fraco
# 1 = obriga resposta somente com contexto recuperado
RAG_LLM_STRICT_CONTEXT_ONLY=0
# Fallback automatico Windows -> WSL para vLLM (descobre IP via `wsl hostname -I`)
RAG_LLM_WSL_DISCOVERY_ENABLED=0
# Opcional: fixa manualmente o IP do WSL para o fallback do vLLM
# RAG_LLM_WSL_HOST_IP=
RAG_REQUIRE_INTERNAL_LLM_URL=1
# Router local deterministico para pipeline
RAG_COMPLEXITY_ROUTER_ENABLED=1
# Override de emergencia: lite|full (vazio = automatico)
RAG_PIPELINE_FORCE_MODE=
RAG_LITE_MAX_TOKENS=192
RAG_LITE_TEMPERATURE=0.2
RAG_LITE_HISTORY_MAX_MESSAGES=2
RAG_LITE_HISTORY_MAX_CHARS=1200
RAG_WEB_SEARCH_ENABLED=1
RAG_WEB_SEARCH_TIMEOUT_MS=6000
RAG_WEB_SEARCH_MAX_RESULTS=5
RAG_WEB_SEARCH_CACHE_TTL_MS=30000
# RAG_WEB_SEARCH_USER_AGENT=knexit-rag/1.0 (+https://knexit.local)
PIPELINE_VERSION=v1
RAG_HYBRID_ENABLED=1
RERANK_ENABLED=1
CITATION_ALIGNMENT_ENABLED=1
WRITE_MODE_ENABLED=1
OCR_AUTO_ENABLED=0
RAG_MMR_ENABLED=1
RAG_RETRIEVAL_RUN_AUDIT_ENABLED=1
RAG_GENERATION_RUN_AUDIT_ENABLED=1
RAG_QUERY_CACHE_ENABLED=1
RAG_V2_MULTICALL_LOCK_ENABLED=1
RAG_V2_MULTICALL_MIN_WRITER_CALLS=3
RAG_V2_MULTICALL_MAX_REINFORCEMENT_PASSES=4
# Travas de budget no writer v2 (evita regressao de profundidade em futuras alteracoes)
RAG_V2_WRITER_SECTION_MIN_TOKENS=2200
RAG_V2_WRITER_SECTION_MAX_TOKENS=7600
RAG_V2_WRITER_MERGE_MIN_TOKENS=4200
RAG_V2_WRITER_MERGE_MAX_TOKENS=12288
# Header de progresso do assistant
ASSISTANT_PROGRESS_HEADER_MODE=standard
ASSISTANT_PROGRESS_HEADER_TARGET=chat
ASSISTANT_PROGRESS_HEADER_STYLE=plain
# Prefixar header textual dentro do stream (recomendado manter 0 para evitar poluicao do chat)
ASSISTANT_PROGRESS_HEADER_STREAM_PREFIX=0
# Progress stream dinamico v2
PROGRESS_STREAM_ENABLED=1
TEXT_ANALYSIS_MODULE_ENABLED=1
DYNAMIC_PROGRESS_MESSAGES=1
# Academic Genre Engine
ACADEMIC_ENFORCER_ENABLED=1
ACADEMIC_REPAIR_ENABLED=1
ACADEMIC_REPAIR_MAX_PASSES=1
ACADEMIC_DEFAULT_LANG=pt-BR

# API publica (frontend Vercel -> backend)
# Defina lista explicita (CSV) de origins permitidas para CORS.
PUBLIC_API_ALLOWED_ORIGINS=
# Opcional: origem principal do frontend Vercel (entra automaticamente na allowlist)
VERCEL_FRONTEND_ORIGIN=
# Opcional: origem final da app (entra automaticamente na allowlist)
APP_PUBLIC_ORIGIN=
# API key minima para endpoints publicos protegidos (/chat, /query, /v1/chat/completions)
PUBLIC_API_KEY=
# ou lista de chaves separadas por virgula
PUBLIC_API_KEYS=
# Frontend (cliente) deve enviar a mesma chave em x-api-key.
# Prefira NEXT_PUBLIC_PUBLIC_API_KEY; NEXT_PUBLIC_API_KEY permanece por compatibilidade.
NEXT_PUBLIC_PUBLIC_API_KEY=
NEXT_PUBLIC_API_KEY=
# Limite de payload JSON (bytes)
PUBLIC_API_MAX_BODY_BYTES=262144
# Rate limiting basico em memoria
PUBLIC_API_RATE_LIMIT_ENABLED=1
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX=60
# Validacoes basicas de entrada para rotas de chat/query
PUBLIC_API_MAX_MESSAGE_CHARS=32000
PUBLIC_API_MAX_QUESTION_CHARS=32000
PUBLIC_API_MAX_HISTORY_ITEMS=20
PUBLIC_API_MAX_HISTORY_ITEM_CHARS=12000
PUBLIC_API_MAX_OPENAI_MESSAGES=30
PUBLIC_API_MAX_OPENAI_MESSAGE_CHARS=32000

# Paths (consolidacao NVMe/NVMe2 - opcionais)
# Se NVME_BASE_PATH estiver definido, os paths relativos abaixo podem ser resolvidos nele.
NVME_BASE_PATH=
MIGRATIONS_PATH=supabase/migrations
KNEXAI_MIGRATION_FILE=supabase/migrations/20260302195000_create_knexai_unified_local.sql
LEGACY_MIGRATIONS_PATH=supabase/migrations_legacy
STORAGE_BASE_PATH=data
DOCUMENTS_BASE_PATH=docs
EMBEDDINGS_BASE_PATH=models
LOCAL_LLM_MODEL_DEFAULT=models/CModelosMistral-7B-Instruct-v0.2-AWQ
TEMP_WORKDIR_PATH=.tmp
EXPORTS_BASE_PATH=data/exports
RAG_RAW_DOCUMENTS_PATH=data/rag/raw
RAG_EXTRACTED_TEXT_PATH=data/rag/text
RAG_ADMIN_BULK_BASE_PATH=data/rag/bulk
DOCKER_DATA_ROOT=/var/lib/docker
DOCKER_ENGINE_TEMPLATE_PATH=infra/docker/docker-desktop-engine.nvme2.json
DOCKER_DESKTOP_EXE=C:\\Program Files\\Docker\\Docker\\Docker Desktop.exe
ANM_WSL_WORKSPACE_DIR=
ANM_WSL_ENTRY_SCRIPT=scripts/serve-anm.sh
ANM_WSL_DISTRO=
ANM_WSL_USER=
VLLM_WSL_WORKSPACE_DIR=
VLLM_WSL_ENTRY_SCRIPT=scripts/serve-vllm.sh
VLLM_WSL_DISTRO=
VLLM_WSL_USER=
NEXT_WSL_WORKSPACE_DIR=
NEXT_WSL_ENTRY_SCRIPT=scripts/serve-next.sh
NEXT_WSL_DISTRO=
NEXT_WSL_USER=
# Guard rails de estabilidade do startup do vLLM (WSL)
VLLM_REUSE_EXISTING=1
VLLM_FORCE_RESTART=0
VLLM_KILL_PORT_OWNER=1
VLLM_GPU_INDEX=0
VLLM_MIN_FREE_GPU_MB=2500
VLLM_REQUIRE_NVIDIA_SMI=0
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_MEMORY_UTILIZATION=0.90
# Args adicionais opcionais para `vllm serve` (ex.: --disable-log-requests)
VLLM_EXTRA_ARGS=
ANM_CHECKPOINT_DIR=anm_backend/data/checkpoints
ANM_VENV_DIR=.anm-venv
IDENTITY_MIGRATIONS_POLICY=required
ANM_CHECKPOINT_RETENTION_DAYS=14
EXPORTS_RETENTION_DAYS=60

# Supabase Identity (ecosistema)
NEXT_PUBLIC_IDENTITY_SUPABASE_URL=https://SEU-IDENTITY-REF.supabase.co
NEXT_PUBLIC_IDENTITY_SUPABASE_ANON_KEY=SEU_IDENTITY_ANON_KEY_AQUI
IDENTITY_SUPABASE_SERVICE_ROLE_KEY=SEU_IDENTITY_SERVICE_ROLE_KEY_AQUI
IDENTITY_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Upstash / Vercel KV (Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# vLLM local
# execute `npm run serve:vllm:wsl` para iniciar o motor com models/CModelosMistral-7B-Instruct-v0.2-AWQ na GPU (ajuste host/porta se necessário)
LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_LLM_API_KEY=token-local
LOCAL_LLM_MODEL=models/CModelosMistral-7B-Instruct-v0.2-AWQ

LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=mistral-awq
LLM_API_KEY=token-local
LLM_TIMEOUT_MS=45000
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=8192

# Compatibilidade legada (fallback automatico)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=mistral-awq
VLLM_API_KEY=token-local
VLLM_CONTEXT_WINDOW=8192
VLLM_MAX_TOKENS=8192

# Resend (SMTP/API)
RESEND_API_KEY=re_SUA_KEY_knexspace-app-resend
RESEND_FROM=no-reply@auth.knexspace.com
KNEXCHAT_OTP_SALT=troque-por-um-segredo-aleatorio


# Domínio opcional para restringir login (deixe vazio para aceitar qualquer domínio além dos e-mails explicitamente permitidos em código)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=

# hCaptcha (opcional)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Provider de execucao do KnexAI
# direct = Next -> vLLM
# anm    = Next -> ANM backend -> vLLM
KNEXAI_ENGINE_MODE=direct
# Endpoint direto do KnexAI deve ser host-only por padrao para evitar ambiguidade Windows/WSL.
KNEXAI_LLM_HOST_ONLY=1
KNEXAI_LLM_FALLBACK_BASE_URLS=
ANM_BACKEND_BASE_URL=http://127.0.0.1:8100
ANM_BACKEND_TIMEOUT_MS=45000
KNEXAI_ANM_SOFT_TIMEOUT_MS=200
KNEXAI_ANM_FALLBACK_TO_DIRECT=1
ANM_CHAT_MAX_TOKENS=4096
# Orquestracao multi-etapas (memoria de processo secundaria)
SECONDARY_PROCESS_MEMORY_ENABLED=1
CHAT_SECONDARY_PROCESS_MEMORY_ENABLED=1
WRITE_SECONDARY_PROCESS_MEMORY_ENABLED=1
SECONDARY_PROCESS_MEMORY_CROSS_CALL_ENABLED=1
CHAT_SECONDARY_PROCESS_MEMORY_CROSS_CALL_ENABLED=1
WRITE_SECONDARY_PROCESS_MEMORY_CROSS_CALL_ENABLED=1
SECONDARY_PROCESS_MEMORY_TTL_SECONDS=900
SECONDARY_PROCESS_MEMORY_MAX_SESSIONS=512
RESPONSE_ORCHESTRATION_MAX_CYCLES=3
CHAT_MAX_RESPONSE_CYCLES=3
WRITE_MAX_RESPONSE_CYCLES=3
TARGET_CHUNK_TOKENS=320
MAX_TOTAL_RESPONSE_TOKENS=4096
CONTINUITY_SUMMARY_MAX_TOKENS=180
REDUNDANCY_THRESHOLD=0.86
CONTRADICTION_CHECK_ENABLED=0
FORCE_FINAL_SYNTHESIS=0
# Persistencia opcional da runtime SQL da ANM (schema knex_write_runtime via PostgREST/Supabase)
ANM_RUNTIME_SQL_PERSIST_ENABLED=0
ANM_RUNTIME_SQL_URL=
ANM_RUNTIME_SQL_SERVICE_KEY=
ANM_RUNTIME_SQL_SCHEMA=knex_write_runtime
ANM_RUNTIME_SQL_TIMEOUT_S=3.5
ANM_RUNTIME_SQL_FAILURE_THRESHOLD=3
# Identity runtime layer (continuous, independent from composer click)
ANM_IDENTITY_RUNTIME_KEY=default
ANM_IDENTITY_RUNTIME_PERSISTENT_ENABLED=1
ANM_IDENTITY_RUNTIME_TICK_MS=700
ANM_IDENTITY_MIN_HEALTHY_FPS=6
# Optional seed source list (JSON array)
# ANM_IDENTITY_SOURCE_LIST=[{"source_id":"webcam-main","name":"Webcam principal","source_type":"local","device_ref":"device://0","resolution":"1280x720","fps":30,"priority":100,"active":true,"connected":true}]
ANM_IDENTITY_SQL_PERSIST_ENABLED=0
ANM_IDENTITY_SQL_URL=
ANM_IDENTITY_SQL_SERVICE_KEY=
ANM_IDENTITY_SQL_SCHEMA=knex_identity_runtime
ANM_IDENTITY_SQL_TIMEOUT_S=2.5
ANM_IDENTITY_SQL_FAILURE_THRESHOLD=3
# Fase 0 - alivio operacional vLLM (segmentacao controlada de paragrafos)
PHASE0_SEGMENTED_EMISSION_ENABLED=1
PHASE0_CHAT_SEGMENTED_EMISSION_ENABLED=1
PHASE0_WRITE_SEGMENTED_EMISSION_ENABLED=1
# 1 = fase 0 roda em caminho leve antes dos modulos avancados (pre-expansao)
PHASE0_PRE_EXPANSION_STRICT_ENABLED=1
# 0 = ativacao por fluxo (metadata); 1 = auto para todo request no orquestrador
PHASE0_SEGMENTED_EMISSION_AUTO_ENABLED=0
PHASE0_DENSITY_SHORT_THRESHOLD=1.15
PHASE0_DENSITY_MEDIUM_THRESHOLD=2.60
PHASE0_MAX_CALLS=3
PHASE0_FIRST_CHUNK_MIN_TOKENS=120
PHASE0_FIRST_CHUNK_TARGET_TOKENS=150
PHASE0_FIRST_CHUNK_MAX_TOKENS=180
PHASE0_PER_CALL_MAX_TOKENS=180

# Frontend chat (streaming)
NEXT_PUBLIC_RAG_MAX_RESPONSE_TOKENS=32768
NEXT_PUBLIC_CHAT_STREAM_DELAY_MS=16

# LiveKit (se usado)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
