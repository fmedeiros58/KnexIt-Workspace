# Rename to .env.local and fill with your keys

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mux (optional for signed playback if you use it on server routes)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mercado Pago
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=




























































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































# Letícia mock mode (default true in development via code)
# Set to "1" to force mock in any env; set to "0" to force disable
LETICIA_MOCK=1


# vLLM server (OpenAI-compatible) e modelo
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
